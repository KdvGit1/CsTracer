# TRACER Discord botu ayarları. Bu dosyayı .env olarak kopyala ve doldur.
# .env dosyası sırlar içerir: paylaşma, git'e ekleme (zaten .gitignore'da).

# --- Zorunlu (tek gereken bu) -------------------------------------------------
# Discord Developer Portal → Applications → Bot → Reset Token
DISCORD_TOKEN=

# --- Boş bırakılabilir (bot Discord'dan kendisi öğrenir) -------------------------
# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# Bot sahibinin Discord kullanıcı kimliği (/admin için). Boşsa uygulamanın sahibi kullanılır.
OWNER_IDS=

# --- Önerilen ---------------------------------------------------------------
# Botun internetten erişilen adresi (HTTPS önerilir, ör. Caddy + DuckDNS).
# Açarsan: büyük demo yükleme bağlantısı, Steam ile doğrulama ve CS2 canlı (GSI).
PUBLIC_URL=
HTTP_PORT=8787
# Caddy/nginx arkasındaysan 127.0.0.1 yap; doğrudan açacaksan 0.0.0.0.
HTTP_HOST=127.0.0.1

# Steam Web API anahtarı: https://steamcommunity.com/dev/apikey
# Özel profil adları, Steam adı/avatarı ve resmî maç geçmişi (paylaşım kodu) takibi için.
STEAM_API_KEY=

# FACEIT Data API anahtarı: https://developers.faceit.com/ → App Studio → API keys (Server side)
FACEIT_API_KEY=
# FACEIT Downloads API tokenı (FACEIT onayı gerekir). Varsa FACEIT demoları otomatik indirilir.
FACEIT_DOWNLOADS_TOKEN=

# --- İsteğe bağlı: paylaşım kodundan otomatik Steam demosu ------------------
# Sadece bu iş için açılmış AYRI bir Steam hesabı kullan (asla kendi hesabını değil).
# Hesap CS2'ye sahip olmalı (ücretsiz). Steam Guard mobil açıksa shared_secret gerekir.
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=

# --- Sunucu kaynakları (Oracle A1 2 OCPU / 12 GB için uygun varsayılanlar) ----
ANALYSIS_CONCURRENCY=1
ANALYSIS_MEMORY_MB=6144
ANALYSIS_TIMEOUT_MIN=15
MAX_DEMO_MB=800
KEEP_ANALYSES_PER_USER=40
KEEP_DEMOS=false
TRACKER_INTERVAL_MIN=20

# --- Gelir/limit ayarları (0 = herkese sınırsız) -------------------------------
FREE_DAILY_ANALYSES=0
# Discord Premium Apps SKU kimlikleri (bölgen destekliyorsa), virgülle ayrılmış.
PREMIUM_SKU_IDS=
# /premium komutundaki destek bağlantısı (Patreon, Shopier, Ko-fi, kendi siten...).
SUPPORT_URL=

# --- Diğer -------------------------------------------------------------------
# Komutları önce tek bir test sunucusunda denemek için (anında görünür).
DEV_GUILD_ID=
# Kalıcı veriler (SQLite + analiz dosyaları). Varsayılan: discord-bot/data
DATA_DIR=
# Şifreli saklanan Steam kimlik kodları için anahtar. Boşsa data/secret.key üretilir.
BOT_SECRET_KEY=
LOG_LEVEL=info
